# Copy this file to .env and fill in your values
# Never commit .env to version control

# Required: Your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Claude model to use (default: claude-sonnet-4-5)
MODEL_ID=claude-sonnet-4-5

# Optional: Comma-separated list of allowed frontend origins (in addition to localhost)
# Example: FRONTEND_URL=https://dr-code.vercel.app
FRONTEND_URL=

# Optional: Server port (Railway sets this automatically)
PORT=3001

# Optional: Max requests per IP per hour (default: 10)
RATE_LIMIT_MAX=10
